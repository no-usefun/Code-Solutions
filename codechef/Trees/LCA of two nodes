import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef
{
	public static void main (String[] args) throws java.lang.Exception
	{
		Scanner sc = new Scanner(System.in);
		
		int n = sc.nextInt();
		int a = sc.nextInt();
		int b = sc.nextInt();
		
		List<List<Integer>> adj = new ArrayList<>(n+1);
		
		for(int i=0; i<=n; i++){
		    adj.add(new ArrayList<>());
		}
		
		for(int i=1; i<n; i++){
		    int u = sc.nextInt();
		    int v =  sc.nextInt();
		    adj.get(u).add(v);
		    adj.get(v).add(u);
		}
		
		int lcs = dfs(1,-1,adj,a,b);
		System.out.println(lcs);
	}
    
    static int dfs(int node, int parent, List<List<Integer>> adj, int a, int b){
        if(node == a || node== b){
            return node;
        }
        
        int found = -1;
        
        for(int neighbor: adj.get(node)){
            if(neighbor != parent){
                int h = dfs(neighbor, node, adj, a, b);
                
                if(h != -1){
                    if(found == -1){
                        found = h;
                    } else{
                        return node;
                    }
                }
            }
        }
        
        return found;
    }	
}