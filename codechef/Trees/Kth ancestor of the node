import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef{
	public static void main (String[] args) throws java.lang.Exception{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		int k = sc.nextInt();
		int node = sc.nextInt();
		
		List<List<Integer>> adj = new ArrayList<>(n+1);
		
		for(int i=0; i<=n; i++){
		    adj.add(new ArrayList<>());
		}
		
		for(int i=1; i<n; i++){
		    int u = sc.nextInt();
		    int v = sc.nextInt();
		    
		    adj.get(u).add(v);
		    adj.get(v).add(u);
		}
		
		int[] parent = new int[n+1];
		parent[1] = -1;
		bfs(1, adj, parent);
		
		int anscestor = node;
		while(k-->=0 && anscestor!=-1){
		    anscestor = parent[anscestor];
		}
		
		System.out.println(anscestor);
	}
	
	static void bfs(int node, List<List<Integer>> adj, int[] parent){
	    Queue<Integer> q =  new LinkedList<>();
	    q.add(node);
	    while(!q.isEmpty()){
    	    int curr = q.poll();
	        for(int neighbor: adj.get(curr)){
    	        if(parent[neighbor]==0){
    	            q.add(neighbor);
    	            parent[neighbor] = curr;
    	        }
    	    }
	    }
	}
}
