import java.util.*;
import java.lang.*;
import java.io.*;

class Codechef{
    static long[] subtreeSum;
    
	public static void main (String[] args) throws java.lang.Exception{
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		
		List<List<Integer>> adjTree = new ArrayList<>(n+1);
		
		for(int i=0; i<=n; i++){
		    adjTree.add(new ArrayList<>());
		}
		
		for(int i=1; i<n; i++){
		    int u = sc.nextInt();
		    int v = sc.nextInt();
		    adjTree.get(u).add(v);
		    adjTree.get(v).add(u);
		}
		
		subtreeSum = new long[n+1];
		
		dfs(1,-1,adjTree);
		
		for(int i=1; i<=n; i++){
		    System.out.print(subtreeSum[i]+" ");
		}
		
		sc.close();

	}
	
	static void dfs(int node, int parent, List<List<Integer>> adjTree){
	    subtreeSum[node] = node;
	    for(int neighbor: adjTree.get(node)){
	        if(neighbor != parent){
	            dfs(neighbor, node, adjTree);
	            subtreeSum[node] += subtreeSum[neighbor];
	        }
	    }
	}
}
