import java.util.*;

public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        
        int t = sc.nextInt();
        while(t-- > 0){
            int n = sc.nextInt();
            int s = sc.nextInt();
            int x = sc.nextInt();
            int[] arr = new int[n];
            for(int i=0; i<n; i++){
                arr[i] = sc.nextInt();
            }
            
            System.out.println(findSol(arr,n,s,x)?"YES":"NO");
        }
        sc.close();
    }
    
    public static boolean findSol(int[] arr, int n, int s, int x){
        int sum =  0;
        
        for(int val: arr){
            sum += val;
        }
        
        if(sum > s) return false;
        
        return ((s-sum)%x==0 ? true:false);
    }
}