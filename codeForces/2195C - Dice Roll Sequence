import java.util.*;

public class Main{
    public static void main(String[] args){
        Scanner sc =new Scanner(System.in);
        
        int t = sc.nextInt();
        while(t-- > 0){
            int n = sc.nextInt();
            int[] arr = new int[n];
            
            for(int i=0; i<n; i++){
                arr[i] = sc.nextInt();
            }
            int count=0;
            int i=0;
            while(i<n-1){
                if(arr[i] + arr[i+1] == 7 || arr[i]==arr[i+1]){
                    count++;
                    i+=2;
                }else{
                    i++;
                }
            }
            
            System.out.println(count);
            
        }
        sc.close();
    }
}