import java.util.*;
 
public class Main{
    public static void main(String[] args){
        Scanner sc =new Scanner(System.in);
        
        int t = sc.nextInt();
        while(t-- > 0){
            int n = sc.nextInt();
            int[] arr = new int[68];
            
            for(int i=0; i<n; i++){
                arr[sc.nextInt()] += 1;
            }
            
            if(arr[67]>=1){
                System.out.println("YES");
            } else{
                System.out.println("NO");
            }
        }
        sc.close();
    }
}