import java.util.*;

public class Main{
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        
        int t = sc.nextInt();
        while(t-- > 0){
            int n = sc.nextInt();
            int q = sc.nextInt();
            int[] A = new int[n];
            for(int i=0; i<n; i++){
                A[i] = sc.nextInt();
            }
            int[] B = new int[n];
            for(int i=0; i<n; i++){
                B[i] = sc.nextInt();
            }
            int[] arr = findSol(A,B,n);
            while(q-- > 0){
                int l = sc.nextInt()-1;
                int r = sc.nextInt()-1;
                
                System.out.print(sum(arr,l,r)+" ");
            }
            System.out.println();
        }
        sc.close();
    }
    
    public static int[] findSol(int[] A, int[] B, int n){
        int[] arr = new int[n];
        arr[n-1] = Math.max(A[n-1],B[n-1]);
        
        for(int i=n-2; i>=0; i--){
            arr[i] = Math.max(Math.max(A[i],arr[i+1]),B[i]);
        }
        
        for(int i=1; i<n; i++){
            arr[i] += arr[i-1];
        }
        
        return arr;
    }
    
    public static int sum(int[] arr, int l, int r){
        if(l==0){
            return arr[r];
        }
        
        return arr[r] - arr[l-1];
    }
}